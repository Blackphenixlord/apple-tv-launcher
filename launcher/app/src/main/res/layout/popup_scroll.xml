<?xml version="1.0" encoding="utf-8"?>
<!-- A glass menu too long for the screen (Background > Download aerials): popup_inputs' panel with its rows in a
     ScrollView, which MainActivity caps at most of the screen height. Focus moving down the rows scrolls it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="6dp"
    android:elevation="12dp">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>

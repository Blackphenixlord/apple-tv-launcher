<?xml version="1.0" encoding="utf-8"?>
<!-- The clock panel (MainActivity.showClockPanel): drops from the clock capsule in the top-right corner and
     shows the exact time with seconds, larger, on the same smoked glass as the Inputs menu. OK or Back closes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/glass_panel"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="22dp"
    android:paddingBottom="22dp"
    android:elevation="12dp"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextClock
            android:id="@+id/bigClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm:ss"
            android:format24Hour="HH:mm:ss"
            android:textAppearance="@style/TextAppearance.TV.HeadlineMedium"
            android:textSize="44sp"
            android:includeFontPadding="false" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:format12Hour="a"
            android:format24Hour=""
            android:textAppearance="@style/TextAppearance.TV.HeadlineMedium"
            android:textSize="22sp"
            android:textColor="#D9FFFFFF"
            android:textAllCaps="true"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:format12Hour="EEEE, MMMM d"
        android:format24Hour="EEEE, MMMM d"
        android:textAppearance="@style/TextAppearance.TV.LabelMedium"
        android:textSize="15sp"
        android:textColor="#B3FFFFFF" />
</LinearLayout>
